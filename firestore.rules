rules_version = '2';

// Only the email addresses in this list can read or change anything.
// Write emails in small letters. Add family members' emails here later.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          'owner@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
